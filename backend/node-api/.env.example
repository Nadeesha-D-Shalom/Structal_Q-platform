# Copy to .env and fill in. Never commit .env with real secrets.

PORT=5000
JWT_SECRET=change-me-in-production

# MSSQL — if login fails with "password has expired", reset the SQL login in SSMS
# (Security → Logins → your user) and update DB_PASSWORD here.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=your_database
DB_USER=your_sql_login

# Option 1 (simple): plain DB password
DB_PASSWORD=your_sql_password

# Option 2 (recommended): encrypted DB password
# 1) set a secret key (do not commit it):
#    DB_PASSWORD_KEY=some_long_random_secret
# 2) generate encrypted value:
#    node src/utils/secretCrypto.js "your_sql_password"
# 3) paste output into DB_PASSWORD_ENC and remove DB_PASSWORD
DB_PASSWORD_KEY=
DB_PASSWORD_ENC=

ML_SERVICE_URL=http://localhost:8000
